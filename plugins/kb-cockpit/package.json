{
  "name": "dsh-kb-cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Knowledge-base cockpit for the 黄师傅 agent mode: note/link stats, a pre-warmed force-graph of wiki links, and a drop-to-import panel.",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "build.mjs",
    "lib/app.js",
    "vendor/force-graph.min.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  }
}
